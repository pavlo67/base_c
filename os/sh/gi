#!/bin/sh

LIBRARY="$HOME/bin/lib"
if [ ! -r "$LIBRARY" ]; then
    printf "ERROR: library helper is missing or unreadable: %s\n" "$LIBRARY"
    exit 1
fi
. "$LIBRARY"
gi_commands='
echo ""
git add . || exit $?
if git diff --cached --quiet --exit-code; then
    :
else
    staged_status=$?
    case "$staged_status" in
        1) git commit || exit $? ;;
        *) exit "$staged_status" ;;
    esac
fi
git push origin HEAD
'

# Synchronize before any staging, commits or pushes, including the submodule files.
git submodule foreach '
    if [ -f ./s ]; then
        sh ./s || exit $?
    fi
' || exit $?

git submodule foreach "$gi_commands" || exit $?

echo "\nentering main module"
sh -c "$gi_commands"
