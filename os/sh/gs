#!/bin/sh

LIBRARY="/home/admin/bin/lib.sh"
if [ ! -r "$LIBRARY" ]; then
    printf "ERROR: library helper is missing or unreadable: %s\n" "$LIBRARY"
    exit 1
fi
. "$LIBRARY"
enable_rpi_client_network || exit $?
gi_commands='echo "" && git status'

git submodule foreach "$gi_commands" || exit $?

echo "\nentering main module"
sh -c "$gi_commands"
