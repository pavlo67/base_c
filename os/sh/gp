#!/usr/bin/bash

set -e
exec 2>&1

# This check belongs to gp: it validates the index that submodule update uses.
gp_validate_modules() (
    local context='[gp_validate_modules()]'
    local record key value entry metadata path name url
    local -A settings=() module_paths=()
    cd "$1" || return 1
    printf '[gp] Checking submodules in %s\n' "$PWD"

    if [ -f .gitmodules ]; then
        if ! git config --file .gitmodules --list >/dev/null; then
            printf '%s ERROR: Invalid .gitmodules in %s\n' "$context" "$PWD"
            return 1
        fi
        while IFS= read -r -d '' record; do
            key=${record%%$'\n'*}
            value=${record#*$'\n'}
            if [[ -v settings["$key"] ]]; then
                printf '%s ERROR: Duplicate setting %s in %s/.gitmodules\n' "$context" "$key" "$PWD"
                return 1
            fi
            settings["$key"]=$value
        done < <(git config --null --file .gitmodules --get-regexp '^submodule\..*\.(path|url)$')

        for key in "${!settings[@]}"; do
            if [[ $key != *.path ]]; then
                continue
            fi
            path=${settings["$key"]}
            name=${key%.path}
            url=${settings["$name.url"]-}
            if [ -z "$path" ] || [ -z "$url" ]; then
                printf '%s ERROR: Empty path or missing URL for %s in %s/.gitmodules\n' "$context" "$name" "$PWD"
                return 1
            fi
            if [[ -v module_paths["$path"] ]]; then
                printf '%s ERROR: Duplicate submodule path %s in %s/.gitmodules\n' "$context" "$path" "$PWD"
                return 1
            fi
            module_paths["$path"]=$name
        done
    fi

    while IFS= read -r -d '' entry; do
        metadata=${entry%%$'\t'*}
        path=${entry#*$'\t'}
        if [[ $metadata != '160000 '* ]]; then
            continue
        fi
        if [[ $metadata != *' 0' ]]; then
            printf '%s ERROR: Unmerged submodule %s in %s; resolve the index conflict first.\n' "$context" "$path" "$PWD"
            return 1
        fi
        if [[ ! -v module_paths["$path"] ]]; then
            printf '%s ERROR: Submodule %s in %s has no path/URL mapping in .gitmodules; fix the mapping or remove the obsolete gitlink from the index.\n' "$context" "$path" "$PWD"
            return 1
        fi
        # An uninitialized directory may resolve to its parent's repository.
        if [ -e "$path/.git" ]; then
            gp_validate_modules "$path" || return 1
        fi
    done < <(git ls-files --stage -z)
)

repository=$(git rev-parse --show-toplevel)
cd "$repository"
gp_validate_modules "$repository"
# Remember active branches before pull/update detaches submodule HEADs.
gp_branch_state=$(mktemp -d)
export gp_branch_state
trap 'rm -rf -- "$gp_branch_state"' EXIT
git submodule foreach --quiet --recursive '
    key=$(git rev-parse --absolute-git-dir | git hash-object --stdin) || exit $?
    git symbolic-ref --quiet --short HEAD > "$gp_branch_state/$key" || {
        status=$?
        [ "$status" -eq 1 ] || exit "$status"
    }
'
# Validate the pulled index before Git attempts any recursive submodule fetch.
git -c fetch.recurseSubmodules=false pull --no-recurse-submodules origin "$(git branch --show-current)"
gp_validate_modules "$repository"
if ! git submodule update --init --recursive; then
    printf '[gp()] ERROR: Recursive submodule update failed in %s; inspect the Git error above.\n' "$repository"
    exit 1
fi
gp_validate_modules "$repository"
git submodule foreach --recursive '
    # Restore the previous branch only when it can reach the recorded commit
    # by fast-forward; never discard local commits or merge beyond that commit.
    key=$(git rev-parse --absolute-git-dir | git hash-object --stdin) || exit $?
    previous_branch=
    if [ -s "$gp_branch_state/$key" ]; then
        IFS= read -r previous_branch < "$gp_branch_state/$key" || exit $?
    fi
    if [ -n "$previous_branch" ]; then
        target=$(git rev-parse HEAD) || exit $?
        if ! git merge-base --is-ancestor "refs/heads/$previous_branch" "$target"; then
            printf "[gp()] ERROR: Cannot fast-forward %s branch %s to recorded commit %s; branch preserved, resolve the history difference manually.\n" "$displaypath" "$previous_branch" "$target"
            exit 1
        fi
        git checkout "$previous_branch" || exit $?
        git merge --ff-only "$target" || exit $?
        exit 0
    fi

    # Keep the exact commit recorded by the parent repository.
    branch=$(git for-each-ref --format="%(refname:short)" --points-at HEAD refs/heads/ | head -1)
    if [ -n "$branch" ]; then
        git checkout "$branch"
    else
        # A matching branch may only exist as a remote-tracking ref.
        for remote_ref in $(git for-each-ref --format="%(refname)" --points-at HEAD refs/remotes/); do
            if git symbolic-ref -q "$remote_ref" >/dev/null; then
                continue
            fi
            branch=${remote_ref#refs/remotes/}
            branch=${branch#*/}
            if ! git show-ref --verify --quiet "refs/heads/$branch"; then
                git checkout -b "$branch" --track "$remote_ref" || exit $?
                break
            fi
        done

        if ! git symbolic-ref -q HEAD >/dev/null; then
            branch_base="$(basename "$sm_path")_$(date +%m_%d)"
            branch=$branch_base
            suffix=2
            while git show-ref --verify --quiet "refs/heads/$branch"; do
                branch="${branch_base}_$suffix"
                suffix=$((suffix + 1))
            done
            git checkout -b "$branch" || exit $?
        fi
    fi
'

# Updates/checkouts must finish before copying the parent's shared files.
git submodule foreach --recursive '
    if [ -f ./s ]; then
        sh ./s || exit $?
    fi
'
