# Shared platform and executable output selection; no GPIO library dependencies.
if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(arm|aarch64|ARM64)")
    if(CMAKE_CROSSCOMPILING OR NOT EXISTS "/proc/device-tree/model")
        message(FATAL_ERROR "[platform.cmake()] ERROR: automatic RPI detection requires the target device")
    endif()
    file(READ "/proc/device-tree/model" GPIO_BOARD_MODEL)
    if(GPIO_BOARD_MODEL MATCHES "Raspberry Pi Compute Module 5([^0-9]|$)")
        set(SYSTEM "RPI CM5")
    elseif(GPIO_BOARD_MODEL MATCHES "Raspberry Pi Compute Module 4([^0-9]|$)")
        set(SYSTEM "RPI CM4")
    elseif(GPIO_BOARD_MODEL MATCHES "Raspberry Pi 5")
        set(SYSTEM "RPI5")
    elseif(GPIO_BOARD_MODEL MATCHES "Raspberry Pi 4")
        set(SYSTEM "RPI4")
    else()
        message(FATAL_ERROR "[platform.cmake()] ERROR: unsupported Raspberry Pi board")
    endif()
else()
    set(SYSTEM "DESKTOP")
endif()


# Compute Modules use the GPIO implementation of the corresponding Pi generation.
set(GPIO_BOARD_PLATFORM "${SYSTEM}")
if(SYSTEM STREQUAL "RPI CM4")
    set(SYSTEM "RPI4")
elseif(SYSTEM STREQUAL "RPI CM5")
    set(SYSTEM "RPI5")
endif()

if(SYSTEM STREQUAL "RPI4" OR SYSTEM STREQUAL "RPI5")
    set(BIN_BASE_DIR "/")
elseif(SYSTEM STREQUAL "DESKTOP")
    set(BIN_BASE_DIR "${CMAKE_SOURCE_DIR}")
else()
    message(FATAL_ERROR "[platform.cmake()] ERROR: unknown detected platform: ${SYSTEM}")
endif()
